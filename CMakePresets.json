{
  "version": 3,
  "configurePresets": [
    {
      "name": "Debug",
      "displayName": "Debug",
      "description": "Debug build with tests enabled",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_COVERAGE": "OFF",
        "BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "Coverage",
      "displayName": "Coverage",
      "description": "Debug build with tests enabled and code coverage",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_COVERAGE": "ON",
        "BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "Release",
      "displayName": "Release",
      "description": "Release build with tests disabled",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "ENABLE_COVERAGE": "OFF",
        "BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "Benchmark",
      "displayName": "Benchmark",
      "description": "Release with Debug Info build with test disabled and benchmarking enabled",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTS": "OFF",
        "ENABLE_COVERAGE": "OFF",
        "BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "BenchmarkDebug",
      "displayName": "BenchmarkDebug",
      "description": "Debug with tests disabled and benchmarking enabled",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-bench-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "OFF",
        "ENABLE_COVERAGE": "OFF",
        "BUILD_BENCHMARKS": "ON"
      }
    }
  ]
}

